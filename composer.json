{
    "name": "gregorj/serial-port",
    "description": "PHP interfaces and classes for serial port communication.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gregor J.",
            "email": "gregor-j@users.noreply.github.com",
            "role": "developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-sockets": "*",
        "gregorj/to-string": "^1.0",
        "psr/container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GregorJ\\SerialPort\\": "src"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "ext-posix": "*",
        "ext-pcntl": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\GregorJ\\SerialPort\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit --testdox",
        "test:conventions": "./vendor/bin/phpunit --filter UseFunctionImportConventionTest",
        "analyse": "./vendor/bin/phpstan analyse --no-progress",
        "cs": "./vendor/bin/phpcs --standard=.phpcs.xml src tests"
    }
}
